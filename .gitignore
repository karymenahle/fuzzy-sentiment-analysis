# Data (regenerated by scripts, or downloaded separately -- see README)
data/raw/*
data/processed/*
data/embeddings/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep

# Results (regenerated by running the evaluation pipeline)
results/figures/*
results/metrics/*
!results/figures/.gitkeep
!results/metrics/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Env / secrets
.env

# Models (regenerated by running src/baselines/train_final.py)
models/*
!models/.gitkeep